{
  "name": "kannon-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "graphics-test": "node scripts/vehicle-test/serve.mjs --town",
    "vehicle-test": "node scripts/vehicle-test/serve.mjs",
    "vehicle-test:assets": "node scripts/blender/split_vehicle_baseline.mjs --check && node scripts/blender/validate_vehicle_test.mjs",
    "vehicle-test:browser": "node scripts/vehicle-test/verify-browser.mjs",
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/server/*.test.ts tests/acceptance/*.test.ts tests/client/*.test.ts",
    "test:assets": "node scripts/blender/validate_glb.mjs && node scripts/blender/validate_environment.mjs && npm run vehicle-test:assets && node scripts/blender/validate_town_graphics.mjs",
    "check": "npm run test && npm run test:assets && npm run build",
    "town-v2:map": "node --import tsx scripts/blender/export_map.ts > art/source/town-v2/map.json",
    "town-v2:guides": "node scripts/blender/run_blender.mjs --python scripts/blender/import_collision_layout.py -- --map art/source/town-v2/map.json --save art/source/kannon-town-v2.blend",
    "town-v2:guides:check": "node scripts/blender/run_blender.mjs --python scripts/blender/import_collision_layout.py -- --map art/source/town-v2/map.json --check"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tsx": "^4.23.13",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
